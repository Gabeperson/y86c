fn main() {
    while_loops();    
    for_loops();
}


fn while_loops() {
    let c: int = 0;
    while (0) {
        c = 1;
    }
    assert(!c);

    c = 0;
    while (c < 5) {
        c++;
    }
    assert(c == 5);

    c = 0;
    while (1) {
        c++;
        if (c == 3) {
         break;
        }
    }
    assert(c == 3);

    c = 0;
    let i: int = 0;
    while (i < 10){
        i++;
        if (i % 2 == 0) continue;
        c += i;
    }
    assert(c == 1 + 3 + 5 + 7 + 9);

    c = 0;
    let outer: int = 0;
    let inner: int = 0;
    while (outer < 5) {
        let i: int = 0;
        while (i < 5) {
            i++;
            if (i == 4) break;
            if (i == 2) continue;
            inner++;
        }
        outer++;
    }
    assert(outer == 5);
    assert(inner == 2 * 5);

    let a: int = 1500;
    let b: int = 0;
    while (a > 500 && b < 500) {
        a--;
        b++;
    }
    assert(a == 1000);
    assert(b == 500);
}

fn for_loops() {
    let s: int = 0;
    for (let i: int = 0; i<5; i++) {
        s += i;
    }
    assert(s == 0+1+2+3+4);

    let c1: int = 0;
    let c2: int = 0;
    for (let i: int = 0; i < 10; i+=1) {
        c1++;
        if (i % 2 == 0) {
            continue;
        }
        c2++;
        if (i == 7) break;
    }
    assert(c1 == 8);
    assert(c2 == 4);

    let j: int = 0;
    s = 0;
    for (;j < 5;j++) {
        s++;
    }
    assert(s == 5);

    s = 0;
    for (let i: int = 0;; i++) {
        s++;
        if (i == 15) {
            break;
        }
    }
    assert(s == 16);

    s = 0;
    for (let i: int = 11; i > 0;) {
        i--;
        s += i;
    }
    assert(s == 55);

    s = 0;
    for (let i: int = 0;;) {
        s++;
        i++;
        if (i == 15) {
            break;
        }
    }
    assert(s == 15);

    s = 0;
    for (;s < 5;) {
        s++;
    }
    assert(s == 5);

    s = 0;
    for (;;s++) {
        if (s == 5) {
            break;
        }
    }
    assert(s == 5);

    s = 0;
    let k: int = 0;
    for (;;) {
        if (k >= 8) break;
        s++;
        k++;
    }
    assert(s == 8);

    let a: int = 1500;
    let b: int = 0;
    for (;a > 500 && b < 500;) {
        a--;
        b++;
    }
    assert(a == 1000);
    assert(b == 500);

    a = 1500;
    b = 0;
    for (;a > 500 && b < 500; a--) {
        b++;
    }
    assert(a == 1000);
    assert(b == 500);
}

