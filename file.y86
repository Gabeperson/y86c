fn main() {
    let i: int = 0;
    assert(ptr_write(&i) == &i);
    assert(i == 50);
    let s: Struct;
    ptr_struct(&s);
    assert(s.x == 5);
    let gsp: *Struct = ptr_ret();
    assert(gsp == &gs);
    assert(gsp->x == 15000);

    s = Struct {x: 100};
    struct_assign(&s);
    assert(s.x == 15000);

    assert(field_ptr(&gs) == &gs.x);
    let arr: [int; 5];
    arr_ptr(&arr);
    for (let i: int = 0; i < 5; i++) {
        assert(arr[i] == i);
    }

    arr = [0, 0, 0, 0, 0];
    let ptr: *int = arr_ptr_ret(&arr);
    for (let i: int = 0; i < 5; i++) {
        assert(ptr[i] == i);
    }

    let a: int = 0;
    let b: *int = &a;
    ptr_ptr(&b);
    assert(a == 100000);

    l1(&a);
    assert(a == 100);

    l1(&s.x);
    assert(s.x == 100);

    assert(elem(&arr, 3) == &arr[0] + 3);
    assert(ptr_identity(nullptr) == nullptr);

    *ptr_identity(&a) = 5;
    assert(a == 5);
    assert(*ptr_identity(&a) == 5);

    assert(*vti(itv(&a)) == 5);

    set(elem(&arr, 2), 10000000);
    assert(arr[2] == 10000000);

    set(field_ptr(&s), 500000);
    assert(s.x == 500000);
}

fn vti(p: *void) -> *int {
    return p;
}

fn itv(p: *int) -> *void {
    return p;
}

fn ptr_identity(i: *int) -> *int {
    return i;
}

fn elem(a: *[int; 5], i: int) -> *int {
    return &(*a)[i];
}

fn set(p: *int, v: int) {
    *p = v;
}

fn l1(p: *int) {
    l2(p);
}

fn l2(p: *int) {
    *p = 100;
}

fn ptr_ptr(p: **int) {
    **p = 100000;
}

fn arr_ptr_ret(a: *[int; 5]) -> *int {
    arr_ptr(a);
    return a as *void;
}

fn arr_ptr(a: *[int; 5]) {
    for (let i: int = 0; i < 5; i++) {
        (*a)[i] = i;
    }
}

fn field_ptr(s: *Struct) -> *int {
    return &s->x;
}

fn struct_assign(s: *Struct) {
    *s = gs;
}

fn ptr_ret() -> *Struct {
    return &gs;
}

fn ptr_write(ptr: *int) -> *int {
    *ptr = 50;
    return ptr;
}

fn ptr_struct(ptr: *Struct) {
    ptr->x = 5;
}

struct Struct {
    x: int,
}

let gs: Struct = Struct {
    x: 15000,
};
